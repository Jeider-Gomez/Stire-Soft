# Configuración de la base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=basestire

# Configuración de JWT
JWT_SECRET=supersecret123
JWT_EXPIRATION=1h

# Configuración del Tutor Inteligente (LLM)
# El Tutor usa Google Gemini con la clave GRATUITA de Google AI Studio que cada estudiante aporta
# (se pide en el registro, con opción de omitir, o la primera vez que abre el Tutor). No hay clave
# global del servidor: sin clave propia, el Tutor pide configurarla.
GEMINI_MODEL=gemini-flash-latest
# Secreto para cifrar en reposo las claves de los estudiantes (AES-256-GCM): 64 caracteres hexadecimales.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatorio: sin él no se puede guardar ni usar ninguna clave del Tutor (falla cerrado).
TUTOR_KEY_ENCRYPTION_SECRET=

# Quién puede PEDIR el rol docente al registrarse (el registro siempre crea un estudiante; un admin aprueba).
# Lista de dominios de correo separados por comas, por ejemplo: unicor.edu.co
# Vacío = cualquier correo puede pedirlo (igual necesita aprobación de un admin). En producción, pónlo.
TEACHER_EMAIL_DOMAINS=

# Configuración de Redis (Obligatorio para BullMQ / Judge Engine)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Entorno Operativo (Obligatorio para TypeORM/Seguridad)
NODE_ENV=development

# Swagger (/docs): por defecto solo se publica fuera de produccion (NODE_ENV != production).
# Descomentar para forzarlo en cualquier entorno (true) o apagarlo (false).
# SWAGGER_ENABLED=false

# Puerto del servidor
PORT=3001

# Sandbox de ejecucion de codigo de estudiantes (Judge Engine)
#   hardened (default) -> proceso hijo aislado por --permission de Node,
#                          sin infraestructura externa. Unica opcion real hoy.
#   docker  -> ABORTA el arranque: el adaptador Docker aun no esta
#              implementado (el anterior era un mock que aprobaba cualquier
#              codigo con la palabra "correct" — P0-05 de la auditoria).
#   vm      -> ABORTA el arranque: node:vm tiene un escape de sandbox
#              confirmado (P0-01, lectura de secretos + ejecucion de comandos).
SANDBOX_TYPE=hardened

# Docker Config (Para el Judge Engine)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Logging
LOG_LEVEL=debug

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
