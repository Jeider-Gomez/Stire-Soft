# Copia este archivo a .env.prod (NO lo subas a git) y completa los valores.

# Dominio público del backend (apunta a la IP de la VM). Ej.: stire-api.duckdns.org
API_DOMAIN=

# Base de datos (contraseñas largas y distintas)
DB_ROOT_PASSWORD=
DB_PASSWORD=
DB_DATABASE=basestire
DB_USERNAME=stire

# Secretos. Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
TUTOR_KEY_ENCRYPTION_SECRET=

# URL pública del frontend en Vercel (sin barra final). CORS_ORIGIN admite varias separadas por coma.
FRONTEND_URL=https://TU-PROYECTO.vercel.app
CORS_ORIGIN=https://TU-PROYECTO.vercel.app

# Correo de recuperación de contraseña (ver docs/DESPLIEGUE.md §4). Ejemplo con Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu.cuenta.stire@gmail.com
SMTP_PASS=
MAIL_FROM="STIRE <tu.cuenta.stire@gmail.com>"
