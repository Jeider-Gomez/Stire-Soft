# Backend NestJS real. En local normalmente http://localhost:3001.
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Acceso rápido de demostración (botones de rol en login.vue y HeaderNav.vue).
# Apagado por defecto -- no debe estar en producción ni en el flujo normal de
# autenticación. Cuando está en true, los botones hacen login REAL contra el
# backend con cuentas institucionales sembradas (npm run db:seed:demo) -- no
# fabrican ningún token. Poner en true solo en tu .env local de desarrollo.
NUXT_PUBLIC_DEMO_MODE=false
